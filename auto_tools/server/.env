PORT=8787
# 单端口运行:后台和 OAuth 回调都在 8787,回调后跳回同源
WEB_ORIGIN=http://localhost:8787

# 生产环境(应用是在 merchant.joom.com 生产面板创建的)
JOOM_ENV=production

# Joom App 凭证
JOOM_CLIENT_ID=35d20b8120479d4c
JOOM_CLIENT_SECRET=460b693a20c2a6ad41b2144d472c28f6

# 与 Joom App 后台登记的回调地址一致
JOOM_REDIRECT_URI=http://localhost:8787/api/joom/callback

DB_PATH=./data/app.db

# DeepSeek（批量 AI 改标题）。也可在后台「采集预设」页填写，页面里的 Key 优先。

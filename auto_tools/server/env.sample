# 复制为 .env 并填写:  cp env.sample .env

# 服务端口
PORT=8787

# 网页后台地址(用于 OAuth 回调后跳回、CORS 白名单)
WEB_ORIGIN=http://localhost:5173

# Joom 环境: production | sandbox
JOOM_ENV=sandbox

# Joom App 凭证(在 Merchant Panel 创建 App 获得)
JOOM_CLIENT_ID=
JOOM_CLIENT_SECRET=

# OAuth 回调地址,需与 Joom App 后台登记的一致
JOOM_REDIRECT_URI=http://localhost:8787/api/joom/callback

# Mercado Libre Global Selling（也可在后台「Mercado Libre 设置」填写）
# 本地 OAuth 回调必须使用固定的 HTTPS 隧道地址
MERCADOLIBRE_CLIENT_ID=
MERCADOLIBRE_CLIENT_SECRET=
MERCADOLIBRE_REDIRECT_URI=https://your-ngrok-domain.ngrok-free.dev/api/mercadolibre/callback
MERCADOLIBRE_NOTIFICATION_URL=https://your-ngrok-domain.ngrok-free.dev/api/mercadolibre/notifications

# 数据库文件路径
DB_PATH=./data/app.db
